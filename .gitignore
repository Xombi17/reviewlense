# GSD planning directory
.planning/

# Python virtual environment
venv/

# Python cache & compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Serialized model pickle files
backend/models/*.pkl
backend/models/*.joblib

# Large raw datasets (downloaded from Kaggle)
backend/data/raw/*
!backend/data/raw/.gitkeep

# Environment variables / secrets
*.env
*.env.local
.env.development.local
.env.test.local
.env.production.local

# Node.js dependencies and Next.js build output
node_modules/
.next/
out/
build/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS-specific files
.DS_Store
Thumbs.db
