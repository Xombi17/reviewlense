{
  "version": 2,
  "buildCommand": "pip install -r requirements-vercel.txt",
  "devCommand": "python -m uvicorn main:app --reload --port 8000",
  "installCommand": "pip install -r requirements-vercel.txt",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
